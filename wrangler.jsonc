// Cloudflare Worker config. Secrets (TURNSTILE_SECRET_KEY, MS_CLIENT_SECRET) and the Microsoft IDs
// are set in the dashboard (Worker → Settings → Variables and Secrets), not here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gretio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Everything else is served straight from dist/ without running the Worker
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Keep gretio.<account>.workers.dev and per-branch preview links (behind Cloudflare Access)
  "workers_dev": true,
  "preview_urls": true,
  // Don't delete variables set in the dashboard on deploy
  "keep_vars": true,
  "vars": {
    "FORM_FROM": "contact@surrealdev.com",
    "FORM_TO": "contact@surrealdev.com"
  },
  // No forms on the site right now. If one is added, create a KV namespace and uncomment (README: "Setup").
  // "kv_namespaces": [{ "binding": "FORM_LIMITS", "id": "<id>" }],
  // gretio.app and www.gretio.app are not routed here: a Cloudflare Redirect Rule on that
  // zone 301s them to https://gretioapp.com (README: "Setup"), so the site only lives at one domain
  "routes": [
    { "pattern": "gretioapp.com", "custom_domain": true },
    { "pattern": "www.gretioapp.com", "custom_domain": true }
  ],

  "env": {
    // The staging branch deploys here (scripts/deploy-branch.mjs): a separate Worker, noindexed
    "staging": {
      "name": "gretio-staging",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": true
      },
      "keep_vars": true,
      "vars": {
        "FORM_FROM": "contact@surrealdev.com",
        "FORM_TO": "contact@surrealdev.com",
        "NOINDEX": "1"
      },
      // "kv_namespaces": [{ "binding": "FORM_LIMITS", "id": "<id>" }],
      // Must be set: without it staging inherits the top-level routes and takes gretioapp.com from production.
      // For a staging domain: [{ "pattern": "staging.gretioapp.com", "custom_domain": true }]
      "routes": []
    }
  }
}
